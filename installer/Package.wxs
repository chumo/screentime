<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="ScreenTime" Manufacturer="ScreenTime" Version="1.0.0.0"
             UpgradeCode="E8F3A1B2-4C5D-6E7F-8A9B-0C1D2E3F4A5B">

        <MajorUpgrade DowngradeErrorMessage="A newer version of ScreenTime is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="ProductFeature" Title="ScreenTime" Level="1">
            <ComponentGroupRef Id="ServiceComponents" />
            <ComponentGroupRef Id="LockScreenComponents" />
            <ComponentGroupRef Id="ConfigComponents" />
        </Feature>

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="ScreenTime">
                <Directory Id="ServiceFolder" Name="Service" />
                <Directory Id="LockScreenFolder" Name="LockScreen" />
                <Directory Id="ConfigFolder" Name="Config" />
            </Directory>
        </StandardDirectory>

        <ComponentGroup Id="ServiceComponents" Directory="ServiceFolder">
            <Files Include="$(var.ServicePublishDir)\**" />
        </ComponentGroup>

        <ComponentGroup Id="LockScreenComponents" Directory="LockScreenFolder">
            <Files Include="$(var.LockScreenPublishDir)\**" />
        </ComponentGroup>

        <ComponentGroup Id="ConfigComponents" Directory="ConfigFolder">
            <Files Include="$(var.ConfigPublishDir)\**" />
        </ComponentGroup>

        <!-- Install Windows Service -->
        <ComponentGroup Id="ServiceInstall" Directory="ServiceFolder">
            <Component Id="ServiceInstallComp">
                <File Id="ServiceExe" Source="$(var.ServicePublishDir)\ScreenTime.Service.exe" KeyPath="yes" />
                <ServiceInstall Id="ScreenTimeServiceInstall"
                                Name="ScreenTimeService"
                                DisplayName="ScreenTime Service"
                                Description="Monitors and enforces screen time limits"
                                Start="auto"
                                Type="ownProcess"
                                ErrorControl="normal"
                                Account="LocalSystem" />
                <ServiceControl Id="ScreenTimeServiceControl"
                                Name="ScreenTimeService"
                                Start="install"
                                Stop="both"
                                Remove="uninstall"
                                Wait="yes" />
            </Component>
        </ComponentGroup>

        <!-- Start Menu Shortcut -->
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ScreenTimeMenuFolder" Name="ScreenTime">
                <Component Id="ConfigShortcut">
                    <Shortcut Id="ConfigShortcutFile"
                              Name="ScreenTime Config"
                              Target="[ConfigFolder]ScreenTime.Config.exe"
                              WorkingDirectory="ConfigFolder" />
                    <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
                    <RegistryValue Root="HKCU" Key="Software\ScreenTime" Name="installed"
                                   Type="integer" Value="1" KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>
    </Package>
</Wix>
