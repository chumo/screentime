<Window x:Class="ScreenTime.Config.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTime Configuration" Width="700" Height="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Password Gate -->
        <Grid x:Name="PasswordGate" Grid.Row="0" Grid.RowSpan="2" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock x:Name="PasswordTitle" Text="Enter Superuser Password"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <PasswordBox x:Name="GatePasswordBox" FontSize="16" Padding="8"/>
                <Button Content="Login" Click="GateLogin_Click" Margin="0,12,0,0"
                        Padding="16,8" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock x:Name="GateError" Foreground="Red" FontSize="12"
                           Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>

                <!-- First-time setup -->
                <StackPanel x:Name="SetupPanel" Visibility="Collapsed" Margin="0,20,0,0">
                    <TextBlock Text="Create Superuser Password" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="NewPasswordBox" FontSize="16" Padding="8"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" FontSize="16" Padding="8" Margin="0,8,0,0"/>
                    <Button Content="Set Password" Click="SetPassword_Click" Margin="0,12,0,0"
                            Padding="16,8" HorizontalAlignment="Center" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main Config Panel -->
        <Grid x:Name="ConfigPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="1">
                <!-- Users Tab -->
                <TabItem Header="Users &amp; Limits">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="NewUsernameBox" Width="200" FontSize="14" Padding="4"
                                     ToolTip="Windows username"/>
                            <Button Content="Add User" Click="AddUser_Click" Margin="8,0,0,0"
                                    Padding="12,4" FontSize="14"/>
                            <Button Content="Remove Selected" Click="RemoveUser_Click" Margin="8,0,0,0"
                                    Padding="12,4" FontSize="14"/>
                        </StackPanel>

                        <ListBox x:Name="UserList" Grid.Row="1" SelectionChanged="UserList_SelectionChanged"
                                 FontSize="14"/>

                        <Grid x:Name="LimitsPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Mon (min):" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="MonBox" Grid.Row="0" Grid.Column="1" Width="60" Margin="8,4" HorizontalAlignment="Left"/>
                            <TextBlock Text="Tue (min):" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="TueBox" Grid.Row="1" Grid.Column="1" Width="60" Margin="8,4" HorizontalAlignment="Left"/>
                            <TextBlock Text="Wed (min):" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="WedBox" Grid.Row="2" Grid.Column="1" Width="60" Margin="8,4" HorizontalAlignment="Left"/>
                            <TextBlock Text="Thu (min):" Grid.Row="3" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="ThuBox" Grid.Row="3" Grid.Column="1" Width="60" Margin="8,4" HorizontalAlignment="Left"/>
                            <TextBlock Text="Fri (min):" Grid.Row="4" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="FriBox" Grid.Row="4" Grid.Column="1" Width="60" Margin="8,4" HorizontalAlignment="Left"/>
                            <TextBlock Text="Sat (min):" Grid.Row="5" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="SatBox" Grid.Row="5" Grid.Column="1" Width="60" Margin="8,4" HorizontalAlignment="Left"/>
                            <TextBlock Text="Sun (min):" Grid.Row="6" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox x:Name="SunBox" Grid.Row="6" Grid.Column="1" Width="60" Margin="8,4" HorizontalAlignment="Left"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Settings Tab -->
                <TabItem Header="Settings">
                    <StackPanel Margin="8">
                        <TextBlock Text="Inactivity Timeout (minutes):" FontSize="14" Margin="0,8"/>
                        <TextBox x:Name="InactivityBox" Width="80" FontSize="14" Padding="4" HorizontalAlignment="Left"/>
                        <TextBlock Text="Warning Before Lockout (minutes):" FontSize="14" Margin="0,12,0,0"/>
                        <TextBox x:Name="WarningBox" Width="80" FontSize="14" Padding="4" HorizontalAlignment="Left"/>
                        <TextBlock Text="Day Reset Time (HH:mm):" FontSize="14" Margin="0,12,0,0"/>
                        <TextBox x:Name="ResetTimeBox" Width="80" FontSize="14" Padding="4" HorizontalAlignment="Left"/>
                        <Separator Margin="0,16"/>
                        <TextBlock Text="Change Password:" FontSize="14" FontWeight="Bold" Margin="0,8,0,4"/>
                        <PasswordBox x:Name="ChangePasswordBox" Width="200" FontSize="14" Padding="4" HorizontalAlignment="Left"/>
                        <PasswordBox x:Name="ChangePasswordConfirmBox" Width="200" FontSize="14" Padding="4" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <Button Content="Change Password" Click="ChangePassword_Click"
                                Padding="12,4" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>

                <!-- Usage Tab -->
                <TabItem Header="Usage History">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="User:" VerticalAlignment="Center" FontSize="14"/>
                            <ComboBox x:Name="HistoryUserCombo" Width="150" Margin="8,0"
                                      SelectionChanged="HistoryUser_Changed" FontSize="14"/>
                        </StackPanel>
                        <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  IsReadOnly="True" FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100"/>
                                <DataGridTextColumn Header="Minutes" Binding="{Binding TotalMinutes}" Width="70"/>
                                <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Limit Hit" Binding="{Binding LimitReached}" Width="70"/>
                                <DataGridTextColumn Header="Extra Granted" Binding="{Binding ExtraTimeGranted}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="Save Configuration" Click="Save_Click"
                    Padding="20,10" HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="14"/>
        </Grid>
    </Grid>
</Window>
